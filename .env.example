# Shopee Open API Credentials (Nếu được cấp quyền)
SHOPEE_APP_ID=
SHOPEE_SECRET_KEY=
SHOPEE_GRAPHQL_ENDPOINT=https://open-api.affiliate.shopee.vn/graphql
SHOPEE_MOCK_MODE=true

# Shopee Session Cookie (BẮT BUỘC khi không có Open API)
# Shopee chỉ ghi nhận hoa hồng cho click đi qua short link chính thức s.shopee.vn.
# Thiếu cookie hợp lệ => /api/convert trả 503 + cảnh báo Telegram (không phát link không có hoa hồng).
# Lấy: đăng nhập affiliate.shopee.vn -> DevTools -> Network -> copy NGUYÊN header "Cookie" (gồm csrftoken, SPC_EC, SPC_U...)
# Chỉ đặt trong Vercel Environment Variables / .env.local, tuyệt đối không commit.
SHOPEE_SESSION_COOKIE=
# Mã Affiliate ID (an_xxxxxxxxxxx) - chỉ dùng để đối chiếu trong script kiểm thử attribution (npm run test:real)
SHOPEE_AFFILIATE_ID=

# Upstash Redis Caching (Lấy tại https://upstash.com - Tùy chọn)
UPSTASH_REDIS_REST_URL=https://your-upstash-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here

# Telegram Bot Notification (Tùy chọn - Dùng cho Phase 4)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_personal_chat_id_here

# App Base URL (Dùng khi chạy production)
NEXT_PUBLIC_BASE_URL=https://shopee.mrhulkstore.store

# Cron Job Secret (Bảo vệ API /api/sync-reports)
CRON_SECRET=your_cron_secret_here

# Analytics & Pixel Tracking (Tùy chọn)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_TIKTOK_PIXEL_ID=your_tiktok_pixel_id

